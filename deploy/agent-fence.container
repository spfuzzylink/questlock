[Unit]
Description=Agent Fence local artifact broker
Documentation=https://docs.podman.io/en/latest/markdown/podman-systemd.unit.5.html
StartLimitIntervalSec=60
StartLimitBurst=5

[Container]
Image=localhost/agent-fence:dev
Pull=never
ContainerName=agent-fence
Exec=serve --db /data/fence.db --listen 0.0.0.0:8080
PublishPort=127.0.0.1:8080:8080
# Only the broker and trusted, offline provisioning containers get this volume.
# U maps ownership to the image's non-root UID; Z applies a private SELinux label.
Volume=agent-fence-data:/data:Z,U
User=65532:65532
ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=16m,mode=1777
DropCapability=all
NoNewPrivileges=true
PidsLimit=128
PodmanArgs=--memory=256m --cpus=1
StopTimeout=20

[Service]
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=default.target
