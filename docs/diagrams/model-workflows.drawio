        <mxCell id="page-title" value="One exact task: reuse, claim, or stop" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;resizable=0;connectable=0;fillColor=none;strokeColor=none;fontFamily=Arial;fontColor=#34445e;spacing=0;fontSize=30;fontStyle=1;fontColor=#18243b;" vertex="1" parent="1">
