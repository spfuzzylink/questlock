<mxfile host="app.diagrams.net" version="24.7.17"><diagram name="Local decision routes" id="questlock-system-one"><mxGraphModel dx="1320" dy="860" grid="1" gridSize="10" page="1" pageWidth="1320" pageHeight="860" background="#080c19"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="facts" value="&lt;b&gt;Caller-approved facts&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bounded context + permitted labels&lt;br&gt;Explicit local model; no credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15152e;strokeColor=#93f9e5;fontColor=#f4f3ff;fontSize=16;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="310" height="130" as="geometry" /></mxCell><mxCell id="host" value="&lt;b&gt;Optional host admission&lt;/b&gt;&lt;br&gt;&lt;br&gt;Shared process; max 1 model worker&lt;br&gt;Pause on unavailable resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15152e;strokeColor=#93f9e5;fontColor=#f4f3ff;fontSize=16;spacing=16;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="310" height="130" as="geometry" /></mxCell><mxCell id="select" value="&lt;b&gt;System One style selector&lt;/b&gt;&lt;br&gt;&lt;br&gt;Official TypeSafe adapter + local Ollama&lt;br&gt;One structured call; no retry or fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15152e;strokeColor=#9d7dff;fontColor=#f4f3ff;fontSize=16;spacing=16;" vertex="1" parent="1"><mxGeometry x="800" y="100" width="440" height="130" as="geometry" /></mxCell><mxCell id="policy" value="&lt;b&gt;Go validates; caller decides&lt;/b&gt;&lt;br&gt;&lt;br&gt;Exact labels, model digest, score heuristics&lt;br&gt;Advisory choice or abstention; no authority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15152e;strokeColor=#93f9e5;fontColor=#f4f3ff;fontSize=16;spacing=16;" vertex="1" parent="1"><mxGeometry x="420" y="310" width="440" height="130" as="geometry" /></mxCell><mxCell id="reuse" value="&lt;b&gt;Exact result reuse&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recheck digest and provenance&lt;br&gt;Zero generation when reused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15152e;strokeColor=#93f9e5;fontColor=#f4f3ff;fontSize=16;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="280" height="120" as="geometry" /></mxCell><mxCell id="edit" value="&lt;b&gt;Checked literal edit&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prior caller authorization&lt;br&gt;Exact text + declared checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15152e;strokeColor=#93f9e5;fontColor=#f4f3ff;fontSize=16;spacing=16;" vertex="1" parent="1"><mxGeometry x="360" y="520" width="280" height="120" as="geometry" /></mxCell><mxCell id="reason" value="&lt;b&gt;System Two reasoning&lt;/b&gt;&lt;br&gt;&lt;br&gt;Only approved input subset&lt;br&gt;Existing worker / Codex OSS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15152e;strokeColor=#9d7dff;fontColor=#f4f3ff;fontSize=16;spacing=16;" vertex="1" parent="1"><mxGeometry x="680" y="520" width="280" height="120" as="geometry" /></mxCell><mxCell id="stop" value="&lt;b&gt;Abstain&lt;/b&gt;&lt;br&gt;&lt;br&gt;Malformed, unclear or unsupported&lt;br&gt;Return to caller for judgment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15152e;strokeColor=#93f9e5;fontColor=#f4f3ff;fontSize=16;spacing=16;" vertex="1" parent="1"><mxGeometry x="1000" y="520" width="280" height="120" as="geometry" /></mxCell><mxCell id="review" value="&lt;b&gt;Caller verifies before accepting&lt;/b&gt;&lt;br&gt;&lt;br&gt;Existing permissions and checks still apply&lt;br&gt;Local tokens do not measure hosted Codex usage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#15152e;strokeColor=#93f9e5;fontColor=#f4f3ff;fontSize=16;spacing=16;" vertex="1" parent="1"><mxGeometry x="360" y="720" width="600" height="100" as="geometry" /></mxCell><mxCell id="e0" source="facts" target="host" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#93f9e5;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" source="host" target="select" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#93f9e5;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" source="select" target="policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#93f9e5;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" source="policy" target="reuse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#93f9e5;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" source="policy" target="edit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#93f9e5;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" source="policy" target="reason" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#93f9e5;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" source="policy" target="stop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#93f9e5;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" source="reuse" target="review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#93f9e5;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" source="edit" target="review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#93f9e5;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" source="reason" target="review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#93f9e5;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCel