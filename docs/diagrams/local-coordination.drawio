        <mxCell id="task" value="Task + exact snapshot&#10;Approved inputs and revision" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#172740;fontColor=#eff5ff;strokeColor=#64ddc0;fontSize=15;" vertex="1" parent="1">
