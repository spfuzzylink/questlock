# The workflow supplies only verified files from a published release archive.
FROM scratch
ARG VERSION
ARG REVISION
ARG CREATED
LABEL org.opencontainers.image.title="Questlock" \
      org.opencontainers.image.description="Experimental single-host publishing controls for cooperating agent workers" \
      org.opencontainers.image.source="https://github.com/spfuzzylink/questlock" \
      org.opencontainers.image.url="https://github.com/spfuzzylink/questlock" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}"
COPY --chmod=0755 questlock /usr/local/bin/questlock
COPY LICENSE /LICENSE
COPY THIRD_PARTY_NOTICES.md /THIRD_PARTY_NOTICES.md
COPY BUILDINFO.json /BUILDINFO.json
COPY --chown=65532:65532 --chmod=0700 data/ /data/
USER 65532:65532
WORKDIR /data
ENV TMPDIR=/data
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/questlock"]
CMD ["serve", "--db", "/data/state.db", "--listen", "0.0.0.0:8080", "--allow-remote-http"]
