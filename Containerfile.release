# TLS trust for explicit model calls; the executable remains the verified archive binary.
FROM docker.io/library/golang:1.27.1-bookworm AS trust
# The workflow supplies only verified files from a published release archive.
FROM scratch
ARG VERSION
ARG REVISION
ARG CREATED
LABEL org.opencontainers.image.title="Questlock" \
      org.opencontainers.image.authors="@spfuzzylink (https://github.com/spfuzzylink)" \
      org.opencontainers.image.description="Bounded model workflows and versioned shared state for cooperating agent workers" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/spfuzzylink/questlock" \
      org.opencontainers.image.url="https://github.com/spfuzzylink/questlock" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}"
COPY --chmod=0755 questlock /usr/local/bin/questlock
COPY --from=trust /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=trust /usr/share/doc/ca-certificates/copyright /CA_CERTIFICATES_COPYRIGHT
COPY LICENSE /LICENSE
COPY THIRD_PARTY_NOTICES.md /THIRD_PARTY_NOTICES.md
COPY BUILDINFO.json /BUILDINFO.json
COPY --chown=65532:65532 --chmod=0700 data/ /data/
USER 65532:65532
WORKDIR /data
ENV TMPDIR=/data HOME=/data
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/questlock"]
CMD ["serve", "--db", "/data/state.db", "--listen", "0.0.0.0:8080", "--allow-remote-http"]
